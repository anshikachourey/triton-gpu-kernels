# ---- Python caches / bytecode ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Compiled CUDA build artifacts (rebuilt in Colab; do not commit) ----
# Note: results/diagnostics/**/kernel.cubin are intentionally tracked diagnostic
# artifacts and are force-added; this ignores stray build outputs under cuda/.
cuda/*.so
cuda/*.o

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Packaging / build ----
build/
dist/
*.egg-info/
.eggs/

# ---- Environment & credentials (never commit secrets) ----
.env
.env.*
*.pem
*.key
*.crt
credentials
.netrc
*_rsa
*_ed25519
.aws/
.ssh/

# ---- Jupyter / IPython ----
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---- Tooling / editor ----
.DS_Store
.vscode/
.idea/
*.swp

# ---- Test / coverage caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Keep the results/ directory but ignore noisy local artifacts if desired ----
# (Generated CSVs/PNGs are intentionally committed only when backed by real
#  Colab output; nothing is auto-ignored here so verified results can be added.)
